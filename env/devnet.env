# The devnet addresses (docs/DEVNET_DEPLOYMENT.md): the forwarder's, and the
# adapter's it is initialized with. A first deploy reads the forwarder's
# keypair path from the uncommitted env/devnet.keys.env:
# FORWARDER_PROGRAM_KEYPAIR=<path>.
FORWARDER_PROGRAM_ID=34kd782wMwzkdwGFS5jfGGdTAz8zbaxVczQHs3E8oKF4
PROTOCOL_ADAPTER_PROGRAM_ID=2gH5DnTwDLLFk3oYxnbrceSFdTMtvaxQz29x5W8Etmpx
# The legacy SPL token forwarder whose resources the emergency-migrating
# build migrates too (docs/EMERGENCY_MIGRATION.md): the zero key, since no
# legacy forwarder's balances moved to this one.
LEGACY_FORWARDER_PROGRAM_ID=11111111111111111111111111111111
