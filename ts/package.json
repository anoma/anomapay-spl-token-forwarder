{
  "name": "@anomaorg/anomapay-spl-token-forwarder",
  "version": "0.7.0",
  "description": "Client bindings for the AnomaPay SPL token forwarder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anoma/anomapay-spl-token-forwarder",
    "directory": "ts"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "copy-data": "mkdir -p src/data && cp ../crates/client/idls/spl_token_forwarder.json ../crates/client/idls/emergency_migrating_spl_token_forwarder.json ../crates/client/deployments.json src/data/",
    "prepare": "npm run copy-data",
    "prebuild": "npm run copy-data",
    "build": "tsc",
    "pretsc": "npm run copy-data",
    "tsc": "tsc -p tsconfig.test.json",
    "pretest": "npm run copy-data",
    "test": "vitest run --project unit",
    "pretest:deployed": "npm run copy-data",
    "test:deployed": "vitest run --project deployed",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anchor-lang/core": "^2.0.0-rc.2",
    "@noble/hashes": "^1.8.0",
    "@solana-program/compute-budget": "^0.20.0",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
