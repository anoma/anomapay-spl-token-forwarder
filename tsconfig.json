{
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2022"],
    // The bindings package's sources (`ts/src`), which the scripts import,
    // read their IDLs through JSON import attributes, which need a module
    // mode that has them; node20 compiles the scripts as CommonJS still.
    "module": "node20",
    // The scripts and the package sources they import, under one root.
    "rootDir": ".",
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["client/**/*.ts", "scripts/**/*.ts"],
  "ts-node": {
    // The operator scripts run as CommonJS; the bindings package (`ts/`)
    // they import from is an ES module package, compiled here as CommonJS,
    // whose imports name their modules' `.js` outputs, which the resolver
    // maps back to the `.ts` sources.
    "moduleTypes": { "ts/src/**/*": "cjs" },
    "experimentalResolver": true
  }
}
